# Environment variables for Kinetix + Sentry Cloud Backend

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kinetix_sentry?schema=public

# Cache & PubSub (Redis)
REDIS_URL=redis://localhost:6379

# Cryptography & Token Secrets
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_characters
PAIRING_SECRET=replace_with_a_secure_pairing_secret_key

# Object Storage (S3 / MinIO)
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_PORT=9000
OBJECT_STORAGE_USE_SSL=false
OBJECT_STORAGE_BUCKET=sentry-files
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin

# Client URLs (for CORS and WS)
API_URL=http://localhost:4000
WEBSOCKET_URL=ws://localhost:4000/ws
