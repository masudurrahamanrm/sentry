# Environment variables for Kinetix + Sentry Cloud Backend

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Database (MongoDB)
# Example Atlas URI: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/kinetix_sentry?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/kinetix_sentry

# Database (PostgreSQL - Optional/Legacy)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kinetix_sentry?schema=public

# Cache & PubSub (Redis)
REDIS_URL=redis://localhost:6379

# Cloudflare R2 Object Storage (S3-Compatible Edge Storage)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=sentry-media
R2_PUBLIC_DOMAIN=https://pub-yourcustomsubdomain.r2.dev

# S3 / MinIO Local Fallback
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_PORT=9000
OBJECT_STORAGE_USE_SSL=false
OBJECT_STORAGE_BUCKET=sentry-files
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin

# Cryptography & Token Secrets
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_characters
PAIRING_SECRET=replace_with_a_secure_pairing_secret_key
APP_CLUSTER_SECRET=SECURE_CLUSTER_V2_99A8F74B

# Client URLs (for CORS and WS)
API_URL=http://localhost:4000
WEBSOCKET_URL=ws://localhost:4000/ws

